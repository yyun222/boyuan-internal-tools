# 复制为 .env，并替换为自己的数据库用户名和密码
# 密码中的 @、#、/ 等特殊字符需要 URL 编码
BOYUAN_DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/boyuan_internal_tools

# 留空时自动生成；需要重启后保持登录时设置为固定随机长字符串
BOYUAN_SESSION_SECRET=
BOYUAN_SESSION_MAX_AGE=28800
BOYUAN_SESSION_COOKIE_SECURE=false
BOYUAN_BUSINESS_UTC_OFFSET=8

# OA 单点登录：执行升级 SQL 并配置 OA 服务端后再开启
BOYUAN_OA_SSO_ENABLED=false
# 使用至少 32 字节随机密钥，必须与 OA 服务端配置一致
BOYUAN_OA_SSO_SECRET=
BOYUAN_OA_SSO_AUDIENCE=boyuan-internal-tools
BOYUAN_OA_SSO_MAX_AGE=60
BOYUAN_OA_TODO_BASE_URL=http://36.139.172.238:3551
BOYUAN_OA_TODO_USERNAME=
BOYUAN_OA_TODO_PASSWORD=
BOYUAN_OA_TODO_SERVICE_PATH=/ekp/api/sys-notify/sysNotifyTodoRestService

# 仅首次创建管理员时生效
BOYUAN_INITIAL_ADMIN_EMAIL=root@boyuanpharm.com
BOYUAN_INITIAL_ADMIN_PASSWORD=123123
